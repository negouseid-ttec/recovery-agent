# AWS Account & Region
AWS_ACCOUNT_ID=123456789012
AWS_REGION=us-east-1

# EUM - SMS/RCS
EUM_PHONE_POOL_ID=pool-xxxxxxxx
EUM_ORIGINATION_PHONE=+1XXXXXXXXXX
RCS_AGENT_ID=rcs-agent-xxxxxxxx

# EUM Social - WhatsApp
WHATSAPP_PHONE_NUMBER_ID=whatsapp-xxxxxxxx
WHATSAPP_WABA_ID=waba-xxxxxxxx

# SES - Email
SES_FROM_EMAIL=recovery@yourdomain.com
SES_DOMAIN=yourdomain.com

# Bedrock
BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0

# Demo
DEMO_RECIPIENT_PHONE=+1XXXXXXXXXX
DEMO_RECIPIENT_EMAIL=recipient@example.com
